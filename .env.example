# Server-side only. Never expose this key to the browser.
# Copy to .env.local (gitignored) for local OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Calendar OAuth (server-side only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3002/api/google/callback

# Encrypted Google credential cookie (required on Vercel).
# 32-byte key as base64url or 64-char hex. Do not reuse GOOGLE_CLIENT_SECRET.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ATLAS_CREDENTIAL_COOKIE_KEY=
# Optional override: file (local) or cookie (production). Vercel defaults to cookie.
# ATLAS_CREDENTIAL_STORE=file
